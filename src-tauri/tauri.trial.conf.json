{
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "shortDescription": "本地音效素材管理工作台试用版",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {"type": "skip"},
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
